<Window x:Class="GameTweaks.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GameTweaks"
        Title="SpudBoost" Icon="app.ico" Height="760" Width="1120" MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" StateChanged="Window_StateChanged">
    <!-- Dark custom frame instead of the white Windows title bar. The thin glass edge keeps Windows' shadow and rounded corners. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- One tweak row: name, badges, description, switch -->
        <DataTemplate x:Key="TweakCard">
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/>
                            <Border Style="{StaticResource Badge}" Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Admin" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                            <Border Style="{StaticResource Badge}" Visibility="{Binding PendingNote, Converter={x:Static local:NotNullToVisibility.Instance}}">
                                <TextBlock Text="{Binding PendingNote}" FontSize="11" Foreground="{StaticResource WarnBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource SubTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="1" Style="{StaticResource Switch}"
                                  IsChecked="{Binding IsOn, Mode=TwoWay}" IsEnabled="{Binding CanToggle}"
                                  Click="TweakToggle_Click"/>
                </Grid>
            </Border>
        </DataTemplate>
        <!-- One tweak as a tile in a sideways row: name and badges, short description, switch at the bottom -->
        <DataTemplate x:Key="TweakTile">
            <Border x:Name="Tile" Width="250" Height="168" Margin="0,0,12,0" CornerRadius="14" Padding="16,14"
                    Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    ToolTip="{Binding Description}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                      IsChecked="{Binding IsOn, Mode=TwoWay}" IsEnabled="{Binding CanToggle}" Click="TweakToggle_Click"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource Badge}" Margin="0,0,6,0" Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Admin" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                            <Border Style="{StaticResource Badge}" Margin="0" Visibility="{Binding PendingNote, Converter={x:Static local:NotNullToVisibility.Instance}}">
                                <TextBlock Text="{Binding PendingNote}" FontSize="11" Foreground="{StaticResource WarnBrush}"/>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="40" TextTrimming="WordEllipsis"/>
                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource SubTextBrush}" FontSize="12" TextWrapping="Wrap" TextTrimming="WordEllipsis" Margin="0,6,0,0" LineHeight="17"/>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
                    <Setter TargetName="Tile" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                </Trigger>
                <!-- Switched-on tiles get an accent outline -->
                <DataTrigger Binding="{Binding IsOn}" Value="True">
                    <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentDimBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Game setting rows: slider, switch or dropdown -->
        <games:GameSettingTemplateSelector x:Key="GameSettingSelector" xmlns:games="clr-namespace:GameTweaks.Games">
            <games:GameSettingTemplateSelector.Slider>
                <DataTemplate>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Label}"/>
                            <TextBlock Text="{Binding Hint}" FontSize="11" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap"
                                       Visibility="{Binding Hint, Converter={x:Static local:NotNullToVisibility.Instance}}"/>
                        </StackPanel>
                        <Slider Grid.Column="1" Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding Number, Mode=TwoWay}"
                                TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding DisplayValue}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                    </Grid>
                </DataTemplate>
            </games:GameSettingTemplateSelector.Slider>
            <games:GameSettingTemplateSelector.Toggle>
                <DataTemplate>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                        <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" HorizontalAlignment="Left" IsChecked="{Binding IsOn, Mode=TwoWay}"/>
                    </Grid>
                </DataTemplate>
            </games:GameSettingTemplateSelector.Toggle>
            <games:GameSettingTemplateSelector.Choice>
                <DataTemplate>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Label}"/>
                            <TextBlock Text="{Binding Hint}" FontSize="11" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap"
                                       Visibility="{Binding Hint, Converter={x:Static local:NotNullToVisibility.Instance}}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="200" HorizontalAlignment="Left" ItemsSource="{Binding ChoiceLabels}" SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"/>
                    </Grid>
                </DataTemplate>
            </games:GameSettingTemplateSelector.Choice>
        </games:GameSettingTemplateSelector>

        <!-- A game as a cover-art tile (Library and Home): name over the art, Boost & Play underneath -->
        <DataTemplate x:Key="GameTile">
            <Border x:Name="Tile" Width="150" Margin="0,0,12,12" CornerRadius="14" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="TileScale"/>
                </Border.RenderTransform>
                <StackPanel>
                    <Grid Height="200" Cursor="Hand" MouseLeftButtonUp="GameTile_Click" ToolTip="Open game page">
                        <Grid.Clip>
                            <RectangleGeometry Rect="0,0,148,200" RadiusX="13" RadiusY="13"/>
                        </Grid.Clip>
                        <Rectangle Fill="#10131C"/>
                        <TextBlock Text="{Binding Initial}" FontSize="48" FontWeight="Bold" Foreground="#2C3346"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image x:Name="Cover" Source="{Binding Image}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <!-- Fade to dark at the bottom so the name is readable on any cover -->
                        <Rectangle VerticalAlignment="Bottom" Height="90">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#E6080A10" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,8">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                            <TextBlock Text="{Binding Source}" FontSize="11" Foreground="#B5BCCB"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Margin="8">
                        <Button Content="🚀 Boost &amp; Play" Style="{StaticResource PrimaryButton}" Margin="0" HorizontalAlignment="Stretch" Click="BoostPlay_Click"/>
                        <Button Content="Play" Margin="0,5,0,0" HorizontalAlignment="Stretch" Click="PlayOnly_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <!-- Icons (not cover art) look better small and centred -->
                <DataTrigger Binding="{Binding CoverPath}" Value="{x:Null}">
                    <Setter TargetName="Cover" Property="Width" Value="56"/>
                    <Setter TargetName="Cover" Property="Height" Value="56"/>
                    <Setter TargetName="Cover" Property="Stretch" Value="Uniform"/>
                    <Setter TargetName="Cover" Property="Margin" Value="0,0,0,30"/>
                </DataTrigger>
                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A preset as a clickable card (Tweaks page and welcome screen) -->
        <DataTemplate x:Key="PresetCard">
            <Button Click="Preset_Click" Margin="0,0,8,8" Padding="0" Cursor="Hand" HorizontalContentAlignment="Stretch">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="14,10" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="Scale"/>
                            </Border.RenderTransform>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}">
                        <Run Text="{Binding Emoji, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Name, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource SubTextBrush}" Margin="0,3,0,0"/>
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar: compact status chips (admin, restart needed, update) -->
        <Border Grid.Column="1" Height="46" Padding="20,0,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="PageHeading" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
                <!-- Page tabs for sections with several pages (filled in from code) -->
                <StackPanel x:Name="SubNav" DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" ToolTip="Minimise" Click="MinimizeWindow_Click"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource ChromeButton}" Content="&#xE922;" ToolTip="Maximise" Click="MaximizeWindow_Click"/>
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE8BB;" Tag="close" ToolTip="Close" Click="CloseWindow_Click"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border x:Name="UpdateCard" Visibility="Collapsed" CornerRadius="14" Padding="12,3,4,3" Margin="6,0,0,0"
                            Background="{DynamicResource AccentDimBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                            ToolTip="{Binding Text, ElementName=UpdateCardText}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="UpdateTitle" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="UpdateCardText" FontSize="11" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="220"
                                       TextTrimming="CharacterEllipsis" Text="Keeps all your settings."/>
                            <Button x:Name="UpdateNowButton" Content="Update now" Padding="10,2" Margin="8,0,0,0" FontSize="12" Click="UpdateNow_Click" Style="{StaticResource PrimaryButton}"/>
                        </StackPanel>
                    </Border>
                    <!-- Plain buttons, no outer outline: yellow when changes wait for a restart or sign-out, accent for admin -->
                    <Border x:Name="PendingCard" Visibility="Collapsed" Margin="6,0,0,0" ToolTip="{Binding Text, ElementName=PendingText}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PendingTitle" Visibility="Collapsed"/>
                            <TextBlock x:Name="PendingText" Visibility="Collapsed"/>
                            <Button x:Name="PendingButton" Padding="12,4" Margin="0" FontSize="12" FontWeight="SemiBold" Click="PendingAction_Click"
                                    Background="{StaticResource WarnBrush}" BorderBrush="Transparent" Foreground="#1A1405"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
                        <TextBlock x:Name="AdminText" FontSize="12" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" Margin="4,0,4,0"/>
                        <Button x:Name="AdminButton" Padding="12,4" FontSize="12" Margin="0" Click="RestartAdmin_Click" Style="{StaticResource PrimaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEA18;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Run as admin"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Sidebar -->
        <Border Grid.RowSpan="3" Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,16,18,10">
                    <Image Source="logo.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="19" FontWeight="Bold">
                            <Run Text="Spud" Foreground="{StaticResource TextBrush}"/><Run Text="Boost" Foreground="{DynamicResource AccentBrush}"/>
                        </TextBlock>
                        <TextBlock Text="Potato PC? Boost it." Foreground="{StaticResource SubTextBrush}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
                <!-- Get Support stays at the bottom -->
                <Button DockPanel.Dock="Bottom" Style="{StaticResource SideLink}" Margin="12,2,12,12" Click="GetSupport_Click" ToolTip="Join the SpudBoost Discord for help, bug reports and suggestions">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource NavIcon}" Text="&#xE8A7;" FontSize="15" Margin="0" Width="Auto"/>
                        <TextBlock Style="{StaticResource NavIcon}" Text="&#xE897;"/>
                        <TextBlock Text="Get Support" VerticalAlignment="Center"/>
                    </DockPanel>
                </Button>
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                <StackPanel x:Name="NavList" Margin="0,6,0,8">
                    <RadioButton Style="{StaticResource SideNav}" Tag="home" IsChecked="True" Checked="Section_Checked">
                        <DockPanel>
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE80F;"/>
                            <TextBlock Text="Home" VerticalAlignment="Center"/>
                        </DockPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SideNav}" Tag="optimize" Checked="Section_Checked">
                        <DockPanel>
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE945;"/>
                            <TextBlock Text="Optimizations" VerticalAlignment="Center"/>
                        </DockPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SideNav}" Tag="boost" Checked="Section_Checked">
                        <DockPanel>
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xEC4A;"/>
                            <TextBlock Text="Boost-Up" VerticalAlignment="Center"/>
                        </DockPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SideNav}" Tag="games" Checked="Section_Checked">
                        <DockPanel>
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE7FC;"/>
                            <TextBlock Text="Games" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource NewBadge}" Margin="10,0,0,0" HorizontalAlignment="Left">
                                <TextBlock Text="NEW" FontSize="10" FontWeight="Black" FontStyle="Italic" Foreground="#0B0B0B"/>
                            </Border>
                        </DockPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SideNav}" Tag="monitor" Checked="Section_Checked">
                        <DockPanel>
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE9D9;"/>
                            <TextBlock Text="Hardware Monitor" VerticalAlignment="Center"/>
                        </DockPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SideNav}" Tag="backups" Checked="Section_Checked">
                        <DockPanel>
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE81C;"/>
                            <TextBlock Text="Profiles &amp; Backups" VerticalAlignment="Center"/>
                        </DockPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SideNav}" Tag="settings" Checked="Section_Checked">
                        <DockPanel>
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE713;"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </DockPanel>
                    </RadioButton>
                </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Pages -->
        <Grid Grid.Column="1" Grid.Row="1" x:Name="Pages">

            <!-- Home: score, one big Boost button, quick switches and your games -->
            <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,4,24,20">
                    <Border CornerRadius="18" Background="{DynamicResource HeroBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Padding="28,24" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock x:Name="HomeGreeting" Text="WELCOME BACK" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock x:Name="HomeHeadline" Text="Let's boost this PC" FontSize="28" FontWeight="Bold" Margin="0,2,0,4" TextWrapping="Wrap"/>
                                <TextBlock x:Name="HomeSubline" FontSize="13" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap"
                                           Text="One click turns on the recommended tweaks and Game Boost. Everything can be undone."/>
                                <!-- Spud Score -->
                                <DockPanel Margin="0,18,0,0">
                                    <Grid DockPanel.Dock="Left" Width="74" Height="74" Margin="0,0,16,0">
                                        <Ellipse Stroke="#262D40" StrokeThickness="7"/>
                                        <Path x:Name="ScoreArc" Stroke="{DynamicResource AccentGradientBrush}" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <TextBlock x:Name="ScoreNumber" Text="–" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Button x:Name="ScoreFixButton" DockPanel.Dock="Right" Content="Do it" VerticalAlignment="Center"
                                            Margin="12,0,0,0" Visibility="Collapsed" Click="ScoreFix_Click"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubTextBrush}" Text="SPUD SCORE"/>
                                        <TextBlock x:Name="ScoreRank" FontSize="18" FontWeight="SemiBold" Text="Checking your PC..."/>
                                        <TextBlock x:Name="ScoreNext" FontSize="12" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                            <!-- The big glowing Boost button -->
                            <Button x:Name="BigBoostButton" Grid.Column="1" Click="BigBoost_Click" Cursor="Hand" VerticalAlignment="Center"
                                    ToolTip="Turns on the Competitive preset and Game Boost">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Width="168" Height="168" RenderTransformOrigin="0.5,0.5">
                                            <Grid.RenderTransform>
                                                <ScaleTransform x:Name="BoostScale"/>
                                            </Grid.RenderTransform>
                                            <Ellipse x:Name="Halo" Margin="-10" Opacity="0.25" Fill="{DynamicResource AccentGradientBrush}">
                                                <Ellipse.Effect>
                                                    <BlurEffect Radius="30"/>
                                                </Ellipse.Effect>
                                            </Ellipse>
                                            <Ellipse Fill="{DynamicResource AccentGradientBrush}"/>
                                            <Ellipse Margin="6" Stroke="#40FFFFFF" StrokeThickness="1"/>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="BoostScale" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.2"/>
                                                            <DoubleAnimation Storyboard.TargetName="BoostScale" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.2"/>
                                                            <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.2"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="BoostScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.25"/>
                                                            <DoubleAnimation Storyboard.TargetName="BoostScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.25"/>
                                                            <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" To="0.25" Duration="0:0:0.25"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.6"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel>
                                    <TextBlock Text="⚡" FontSize="34" HorizontalAlignment="Center" Foreground="#0B0B0B"/>
                                    <TextBlock x:Name="BigBoostText" Text="BOOST" FontSize="22" FontWeight="Black" HorizontalAlignment="Center" Foreground="#0B0B0B"/>
                                    <TextBlock x:Name="BigBoostSub" Text="one click" FontSize="11" HorizontalAlignment="Center" Foreground="#3A2A1A"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Quick switches -->
                    <UniformGrid Columns="3" Margin="0,0,-10,0">
                        <Border x:Name="HomeBoostTile" Style="{StaticResource Tile}">
                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=TwoWay}"/>
                                <StackPanel>
                                    <TextBlock Text="🎮  Game Boost" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,8,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border x:Name="HomeCrosshairTile" Style="{StaticResource Tile}">
                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=TwoWay}"/>
                                <Button DockPanel.Dock="Right" Content="Customize" Padding="10,3" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center"
                                        Click="OpenCrosshair_Click" ToolTip="Change the crosshair's look, weapon styles and keys"/>
                                <StackPanel>
                                    <TextBlock Text="🎯  Crosshair" FontWeight="SemiBold"/>
                                    <TextBlock Text="Custom crosshair in Fortnite" FontSize="11" Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,8,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border x:Name="HomeOverlayTile" Style="{StaticResource Tile}">
                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=TwoWay}"/>
                                <StackPanel>
                                    <TextBlock Text="📈  Stats overlay" FontWeight="SemiBold"/>
                                    <TextBlock Text="GPU temp, CPU, RAM and ping in game" FontSize="11" Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,8,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </UniformGrid>

                    <!-- At a glance -->
                    <UniformGrid Columns="3" Margin="0,0,-10,0">
                        <Border Style="{StaticResource Tile}" Cursor="Hand" MouseLeftButtonUp="HomeTweaks_Click">
                            <StackPanel>
                                <TextBlock Text="TWEAKS ON" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubTextBrush}"/>
                                <TextBlock x:Name="HomeTweaksOn" Text="–" Style="{StaticResource StatValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Tile}" Cursor="Hand" MouseLeftButtonUp="HomeMonitor_Click">
                            <StackPanel>
                                <TextBlock Text="PLAYED THIS WEEK" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubTextBrush}"/>
                                <TextBlock x:Name="HomePlayWeek" Text="0 min" Style="{StaticResource StatValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Tile}" Cursor="Hand" MouseLeftButtonUp="HomeLibrary_Click">
                            <StackPanel>
                                <TextBlock Text="GAMES INSTALLED" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubTextBrush}"/>
                                <TextBlock x:Name="HomeGameCount" Text="–" Style="{StaticResource StatValue}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Achievements -->
                    <DockPanel Margin="0,8,0,8">
                        <Border DockPanel.Dock="Right" CornerRadius="6" Background="#1F2535" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock x:Name="AchievementCount" FontSize="12" FontWeight="SemiBold" Foreground="#B5BCCB"/>
                        </Border>
                        <TextBlock Text="Achievements" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ItemsControl x:Name="AchievementList" Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Badge" CornerRadius="12" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        Padding="8,10" Margin="0,0,8,8" ToolTip="{Binding Tip}" Opacity="{Binding Opacity}">
                                    <StackPanel>
                                        <Grid Width="38" Height="38" HorizontalAlignment="Center">
                                            <Ellipse x:Name="Circle" Fill="#1F2535"/>
                                            <TextBlock x:Name="Icon" Text="{Binding Icon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Unlocked}" Value="True">
                                        <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource AccentGradientBrush}"/>
                                        <Setter TargetName="Icon" Property="Foreground" Value="#0B0B0B"/>
                                        <Setter TargetName="Badge" Property="BorderBrush" Value="{DynamicResource AccentDimBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Your games -->
                    <DockPanel Margin="0,8,0,8">
                        <Button DockPanel.Dock="Right" Content="See all" Margin="0" Click="HomeLibrary_Click"/>
                        <TextBlock Text="Jump back in" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ItemsControl x:Name="HomeGames" ItemTemplate="{StaticResource GameTile}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- System tweaks -->
            <ScrollViewer x:Name="TweaksPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="24,16,24,20">
                    <TextBlock Text="System tweaks" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="One-click Windows optimizations. The original value is saved before each change, so turning a switch off puts it back exactly as it was."/>
                    <!-- Collapsed to one line; click to see the details -->
                    <Border x:Name="HealthCard" Style="{StaticResource Card}" BorderBrush="{StaticResource WarnBrush}" Visibility="Collapsed" Margin="0,0,0,10"
                            Cursor="Hand" MouseLeftButtonUp="HealthCard_Click">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock x:Name="HealthToggleText" DockPanel.Dock="Right" Text="Show ▾" FontSize="12" Foreground="{StaticResource WarnBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="HealthHeading" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}"/>
                            </DockPanel>
                            <ItemsControl x:Name="HealthList" Visibility="Collapsed" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4">
                                            <TextBlock Text="{Binding Title, StringFormat=• {0}}" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource SubTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="10,1,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="One-click presets" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                    <ItemsControl x:Name="PresetList" ItemTemplate="{StaticResource PresetCard}" Margin="0,0,-8,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Left" Content="Apply all" Style="{StaticResource PrimaryButton}" Click="ApplyAllSystem_Click"
                                ToolTip="Turns on every tweak except Privacy ones and ones that need extra confirmation, like Memory Integrity."/>
                        <Button DockPanel.Dock="Left" Content="🔒 Privacy pack" Click="ApplyPrivacy_Click"
                                ToolTip="Turns on every Privacy tweak except location (which weather and maps need)."/>
                        <!-- Search: filters the list as you type -->
                        <Grid Margin="6,0,0,0">
                            <TextBox x:Name="TweakSearchBox" VerticalContentAlignment="Center" Padding="28,5,8,5" TextChanged="TweakSearch_TextChanged"/>
                            <TextBlock Text="🔍" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{StaticResource SubTextBrush}"/>
                            <TextBlock x:Name="TweakSearchHint" Text="Search tweaks (e.g. mouse, power, Fortnite)" Margin="29,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Foreground="#5D6577" FontSize="12"/>
                        </Grid>
                    </DockPanel>
                    <!-- One sideways-scrolling row of tweak tiles per section -->
                    <ItemsControl x:Name="SystemList" ItemTemplate="{StaticResource TweakTile}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <StackPanel Margin="0,8,0,6">
                                                        <DockPanel Margin="2,0,0,8">
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                                <Button Content="&#xE76B;" Tag="-1" Style="{StaticResource RowArrow}" Click="RowScroll_Click" ToolTip="Scroll left"/>
                                                                <Button Content="&#xE76C;" Tag="1" Style="{StaticResource RowArrow}" Click="RowScroll_Click" ToolTip="Scroll right" Margin="6,0,0,0"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                                            <Border CornerRadius="6" Background="#1F2535" Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#B5BCCB">
                                                                    <Run Text="{Binding ItemCount, Mode=OneWay}"/><Run Text=" tweaks"/>
                                                                </TextBlock>
                                                            </Border>
                                                        </DockPanel>
                                                        <Grid>
                                                            <ScrollViewer x:Name="RowScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                                          PreviewMouseWheel="RowScroll_MouseWheel" Padding="0,0,0,6">
                                                                <ItemsPresenter/>
                                                            </ScrollViewer>
                                                            <!-- Fade on the right edge hints that the row keeps going -->
                                                            <Rectangle Width="40" HorizontalAlignment="Right" IsHitTestVisible="False" Margin="0,0,0,16">
                                                                <Rectangle.Fill>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                        <GradientStop Color="#000A0C12" Offset="0"/>
                                                                        <GradientStop Color="#FF0A0C12" Offset="1"/>
                                                                    </LinearGradientBrush>
                                                                </Rectangle.Fill>
                                                            </Rectangle>
                                                        </Grid>
                                                    </StackPanel>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                    </ItemsControl>
                    <TextBlock x:Name="NoTweaksFound" Text="No tweaks match your search." Foreground="{StaticResource SubTextBrush}" Visibility="Collapsed" Margin="2,8"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Game boost -->
            <ScrollViewer x:Name="BoostPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="24,16,24,20">
                    <TextBlock Text="Game Boost" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="When a game from your list starts, SpudBoost raises its CPU priority and lowers the priority of background apps. Everything is put back when the game closes."/>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Auto boost" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Status}" Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=TwoWay}"/>
                        </Grid>
                    </Border>
                    <!-- Options as big switch rows -->
                    <Border Style="{StaticResource Card}" Padding="16,6">
                        <StackPanel>
                            <DockPanel Margin="0,8">
                                <ToggleButton x:Name="RaisePriorityBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="BoostOption_Click"/>
                                <StackPanel>
                                    <TextBlock Text="Raise the game's priority to High" FontWeight="SemiBold"/>
                                    <TextBlock Text="The game gets the CPU before anything else." FontSize="12" Foreground="{StaticResource SubTextBrush}"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Height="1" Background="{StaticResource BorderBrush}"/>
                            <DockPanel Margin="0,8">
                                <ToggleButton x:Name="LowerBackgroundBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="BoostOption_Click"/>
                                <StackPanel>
                                    <TextBlock Text="Lower background apps to Below normal" FontWeight="SemiBold"/>
                                    <TextBlock Text="Browsers, launchers and the apps in the list below get less CPU while you play." FontSize="12" Foreground="{StaticResource SubTextBrush}"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Height="1" Background="{StaticResource BorderBrush}"/>
                            <DockPanel Margin="0,8">
                                <ToggleButton x:Name="CloseAppsBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="BoostOption_Click"/>
                                <StackPanel>
                                    <TextBlock Text="Close unnecessary apps when a game starts" FontWeight="SemiBold"/>
                                    <TextBlock Text="Closes the apps in the list at the bottom of this page." FontSize="12" Foreground="{StaticResource SubTextBrush}"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Height="1" Background="{StaticResource BorderBrush}"/>
                            <DockPanel Margin="0,8">
                                <ToggleButton x:Name="KeepClosedBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="BoostOption_Click"/>
                                <StackPanel>
                                    <TextBlock Text="Keep them closed while you play" FontWeight="SemiBold"/>
                                    <TextBlock Text="Apps like OneDrive and Teams reopen themselves. SpudBoost closes them again every 30 seconds until the game exits." FontSize="12" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Height="1" Background="{StaticResource BorderBrush}"/>
                            <DockPanel Margin="0,8">
                                <ToggleButton x:Name="DisableAtStartupBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="DisableAtStartup_Click"/>
                                <StackPanel>
                                    <TextBlock Text="Stop them starting with Windows" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="DisableAtStartupText" FontSize="12" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap"
                                               Text="Turns off the startup entries of the apps in the list, so they don't run in the background at all. Undo any of them on the Startup apps page."/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Games (process names, one per line)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBox x:Name="GamesBox" AcceptsReturn="True" Height="190" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Background apps to lower" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBox x:Name="BackgroundBox" AcceptsReturn="True" Height="190" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="Close them now" Style="{StaticResource PrimaryButton}" Margin="0" VerticalAlignment="Top" Click="CloseAppsNow_Click"/>
                                <StackPanel>
                                    <TextBlock Text="Unnecessary apps to close" FontWeight="SemiBold"/>
                                    <TextBlock Foreground="{StaticResource SubTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,12,0"
                                               Text="Background apps that use CPU and memory but aren't needed while you play. Add or remove names (one per line). Windows, security and anti-cheat processes are always skipped, even if listed. Apps with a window are asked to close normally so they can save."/>
                                </StackPanel>
                            </DockPanel>
                            <TextBox x:Name="AppsToCloseBox" AcceptsReturn="True" Height="150" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Save lists" Style="{StaticResource PrimaryButton}" Click="SaveBoostLists_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Startup apps -->
            <ScrollViewer x:Name="StartupPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="24,16,24,20">
                    <TextBlock Text="Startup apps" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Programs that launch every time you sign in and keep running in the background. Turning one off doesn't uninstall it; you can still open it yourself, and turn it back on here or in Task Manager. Takes effect next sign-in."/>
                    <ItemsControl x:Name="StartupList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="18,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <Border Style="{StaticResource Badge}" Visibility="{Binding Heavy, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Heavy" FontSize="11" Foreground="{StaticResource WarnBrush}"/>
                                                </Border>
                                                <Border Style="{StaticResource Badge}" Visibility="{Binding Protected, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Needed by Windows" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Scope, StringFormat=  ·  {0}}" Foreground="{StaticResource SubTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Command}" Foreground="{StaticResource SubTextBrush}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                      IsEnabled="{Binding CanToggle}" Click="StartupToggle_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Network -->
            <ScrollViewer x:Name="NetworkPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="24,16,24,20">
                    <TextBlock Text="Network" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Latency tweaks for online games. Your original adapter settings are saved and restored when you switch a tweak off."/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="DNS provider" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="DnsCombo" Width="160" Margin="0,0,16,0" SelectionChanged="DnsCombo_SelectionChanged"/>
                        <Button Content="Flush DNS cache" Click="FlushDns_Click"/>
                    </StackPanel>
                    <ItemsControl x:Name="NetworkList" ItemTemplate="{StaticResource TweakTile}" Margin="0,0,-12,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="0,0,0,12"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>

                    <TextBlock Text="Fortnite server ping" Style="{StaticResource SectionTitle}" Margin="0,24,0,10"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Button x:Name="PingButton" DockPanel.Dock="Right" Content="Test ping" Style="{StaticResource PrimaryButton}" Margin="0" Click="TestPing_Click"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" Margin="0,0,12,0"
                                           Text="Measures your ping and jitter (how much it jumps around) to each Fortnite region. Pick the starred one in Fortnite → Settings → Game → Matchmaking Region. Lower jitter matters as much as lower ping."/>
                            </DockPanel>
                            <ItemsControl x:Name="PingList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="RegionText" Text="{Binding Region}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Summary}" Foreground="{StaticResource SubTextBrush}"/>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Best}" Value="True">
                                                <Setter TargetName="RegionText" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="RegionText" Property="Text" Value="{Binding Region, StringFormat=★ {0}}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Fortnite settings -->
            <ScrollViewer x:Name="FortnitePage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="24,16,24,20">
                    <TextBlock Text="Fortnite settings" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Edit Fortnite's own settings file (GameUserSettings.ini) beyond what the in-game menu allows. A backup is taken before every save. Close Fortnite before saving."/>
                    <Border x:Name="FortniteWarning" Style="{StaticResource Card}" BorderBrush="{StaticResource WarnBrush}" Visibility="Collapsed">
                        <TextBlock x:Name="FortniteWarningText" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap"/>
                    </Border>

                    <StackPanel x:Name="FortniteEditor">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="🎯 Competitive preset" Click="CompetitivePreset_Click"/>
                            <Button Content="Reload from file" Click="ReloadFortnite_Click"/>
                        </StackPanel>

                        <TextBlock Text="Display" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Shown when Legacy Performance is picked: it also needs launch options in the Epic launcher -->
                                <Border Grid.Row="6" Grid.ColumnSpan="3" Margin="0,10,0,0" Padding="14,10" CornerRadius="8"
                                        Background="{DynamicResource AccentDimBrush}" Visibility="{Binding IsLegacyPerformance, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="Legacy Performance: one more step" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,8" Foreground="{StaticResource TextBrush}"
                                                   Text="This is Fortnite's old, flattest renderer (DirectX 11 + mobile graphics). Epic has marked it deprecated and may have removed it; if so, Fortnite just uses normal Performance mode. To force it, open the Epic Games Launcher → your profile picture → Settings → scroll to Fortnite → tick Additional Command Line Arguments and paste:"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Text="{x:Static fortnite:FortniteSettings.LegacyLaunchArgs}" IsReadOnly="True" Width="220"
                                                     xmlns:fortnite="clr-namespace:GameTweaks.Fortnite"/>
                                            <Button Content="Copy" Margin="8,0,0,0" Padding="14,4" Click="CopyLegacyArgs_Click"/>
                                        </StackPanel>
                                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource SubTextBrush}"
                                                   Text="To go back, pick another rendering mode here and delete those arguments in the Epic launcher."/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Grid.Row="5" Text="Mesh quality" VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                                    <ComboBox x:Name="MeshCombo" Width="220" SelectedIndex="{Binding MeshQuality, Mode=TwoWay}"
                                              IsEnabled="{Binding IsPerformanceMode}"/>
                                    <TextBlock Text="Performance mode only. Low makes builds flat and plain." Margin="12,0,0,0"
                                               VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                                </StackPanel>

                                <TextBlock Text="Resolution" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                                    <TextBox Width="80" Text="{Binding ResX, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="×" Margin="8,0" VerticalAlignment="Center"/>
                                    <TextBox Width="80" Text="{Binding ResY, UpdateSourceTrigger=PropertyChanged}"/>
                                    <ComboBox x:Name="ResPresetCombo" Width="190" Margin="12,0,0,0" SelectionChanged="ResPreset_SelectionChanged"/>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Text="Window mode" VerticalAlignment="Center"/>
                                <ComboBox x:Name="WindowModeCombo" Grid.Row="1" Grid.Column="1" Width="220" HorizontalAlignment="Left" Margin="0,6"
                                          SelectedIndex="{Binding WindowMode, Mode=TwoWay}"/>

                                <TextBlock Grid.Row="2" Text="Rendering mode" VerticalAlignment="Center"/>
                                <ComboBox x:Name="RenderModeCombo" Grid.Row="2" Grid.Column="1" Width="300" HorizontalAlignment="Left" Margin="0,6"
                                          SelectedIndex="{Binding RenderMode, Mode=TwoWay}"/>

                                <TextBlock Grid.Row="3" Text="3D resolution" VerticalAlignment="Center"/>
                                <Slider Grid.Row="3" Grid.Column="1" Minimum="25" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding ResolutionPercent, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,8"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding ResolutionPercent, StringFormat={}{0}%}" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                <TextBlock Grid.Row="4" Text="FPS limit (0 = unlimited)" VerticalAlignment="Center"/>
                                <Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="360" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding FrameRateLimit, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,8"/>
                                <TextBox Grid.Row="4" Grid.Column="2" Width="56" HorizontalAlignment="Right" VerticalAlignment="Center"
                                         Text="{Binding FrameRateLimit, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="Graphics quality" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}">
                            <ItemsControl ItemsSource="{Binding Qualities}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" Minimum="0" Maximum="3" TickFrequency="1" IsSnapToTickEnabled="True"
                                                    TickPlacement="BottomRight" Value="{Binding Value, Mode=TwoWay}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding LevelName}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <TextBlock Text="Options" Style="{StaticResource SectionTitle}"/>
                        <ItemsControl ItemsSource="{Binding Toggles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="18,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Hint}" Foreground="{StaticResource SubTextBrush}" FontSize="12" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding Value, Mode=TwoWay}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox Content="Lock settings file (read-only) so Fortnite can't reset it" IsChecked="{Binding LockReadOnly, Mode=TwoWay}"/>
                                <TextBlock Foreground="{StaticResource SubTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="20,0,0,0"
                                           Text="While locked, changes you make in Fortnite's own settings menu won't be saved. Unlock it here to change settings in-game."/>
                                <CheckBox x:Name="KeepFortniteBox" Content="Keep these settings: put them back automatically if Fortnite resets them" Margin="0,8,0,4"/>
                                <TextBlock Foreground="{StaticResource SubTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="20,0,0,0"
                                           Text="Fortnite often resets graphics after big updates. SpudBoost checks while Fortnite is closed and restores what you saved here (with a backup). Takes effect when you click Save to Fortnite. Untick it before changing settings in-game."/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Save to Fortnite" Style="{StaticResource PrimaryButton}" Click="SaveFortnite_Click"/>
                            <Button Content="Restore original settings" Click="RestoreFortnite_Click"/>
                        </StackPanel>

                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Backup & undo -->
            <ScrollViewer x:Name="BackupPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="24,16,24,20">
                    <TextBlock Text="Backup &amp; Undo" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Every change SpudBoost makes is recorded with its original value. Use these to put things back."/>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Create restore point" Click="RestorePoint_Click"/>
                            <StackPanel>
                                <TextBlock Text="Windows restore point" FontWeight="SemiBold"/>
                                <TextBlock Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="0,4,12,0"
                                           Text="A full system snapshot you can roll back to from Windows Recovery. Requires admin. Windows allows one every 24 hours."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Undo all tweaks" Style="{StaticResource PrimaryButton}" Click="UndoAll_Click"/>
                            <StackPanel>
                                <TextBlock Text="Undo every tweak" FontWeight="SemiBold"/>
                                <TextBlock x:Name="UndoSummary" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="0,4,12,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Restore Fortnite" Click="RestoreFortnite_Click"/>
                            <StackPanel>
                                <TextBlock Text="Fortnite settings" FontWeight="SemiBold"/>
                                <TextBlock Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="0,4,12,0"
                                           Text="Puts back the GameUserSettings.ini you had before SpudBoost first changed it."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Open folder" Click="OpenBackups_Click"/>
                            <StackPanel>
                                <TextBlock Text="Backup folder" FontWeight="SemiBold"/>
                                <TextBlock x:Name="BackupPathText" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="0,4,12,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <!-- Crosshair overlay -->
            <ScrollViewer x:Name="CrosshairPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="24,16,24,20">
                    <TextBlock Text="Custom crosshair" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Draws your own crosshair in the centre of the screen, on top of the game. It doesn't touch the game itself. Only works when the game runs in Windowed fullscreen (borderless). Some tournaments don't allow overlay crosshairs."/>
                    <Border x:Name="CrosshairWarning" Style="{StaticResource Card}" BorderBrush="{StaticResource WarnBrush}" Visibility="Collapsed">
                        <TextBlock x:Name="CrosshairWarningText" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap"/>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Show crosshair" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Status}" Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,6"/>
                                <CheckBox Content="Only show in Fortnite (hides when you alt-tab or go to the desktop)" IsChecked="{Binding OnlyInGame, Mode=TwoWay}"/>
                                <CheckBox Content="Hide while aiming (right mouse held) so scopes stay clear" IsChecked="{Binding HideWhileAiming, Mode=TwoWay}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Spread while shooting" VerticalAlignment="Center" Width="150"/>
                                    <Slider Width="200" Minimum="0" Maximum="20" Value="{Binding FireSpread, Mode=TwoWay}" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding FireSpread, StringFormat='{}{0} px (0 = off)'}" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Show/hide hotkey" VerticalAlignment="Center" Width="150"/>
                                    <TextBox Width="80" Text="{Binding ToggleKey, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Text="Press it in game to hide or show the crosshair (e.g. F8, empty = off)" Margin="10,0,0,0"
                                               VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SubTextBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Copy crosshair code" Click="CopyCrosshairCode_Click"/>
                                    <Button Content="Paste a friend's crosshair" Click="PasteCrosshairCode_Click"/>
                                </StackPanel>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=TwoWay}"/>
                        </Grid>
                    </Border>

                    <!-- Which crosshair is being edited, and the keys that switch to it -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Editing" VerticalAlignment="Center" Width="110" FontWeight="SemiBold"/>
                                <ComboBox x:Name="CrosshairEditCombo" Width="180" SelectedIndex="{Binding EditIndex, Mode=TwoWay}"/>
                                <CheckBox Content="Use this crosshair" Margin="16,0,0,0" VerticalAlignment="Center"
                                          IsChecked="{Binding WeaponEnabled, Mode=TwoWay}" Visibility="{Binding IsWeapon, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Switch keys" VerticalAlignment="Center" Width="110"/>
                                <TextBox Width="180" Text="{Binding Keys, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SubTextBrush}"
                                           Text="Your Fortnite keys for this weapon's slot, e.g. 2  or  2, Mouse4"/>
                            </StackPanel>
                            <TextBlock Margin="110,8,0,0" FontSize="12" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap"
                                       Text="Fortnite's default keys: 1 = pickaxe, 2–6 = weapon slots 1–5. Put your shotgun's and sniper's slot keys on those crosshairs and the rest on Default. Scroll-wheel weapon switching can't be detected."/>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="240"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Style" VerticalAlignment="Center"/>
                                <ComboBox x:Name="CrosshairStyleCombo" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4" SelectedItem="{Binding Style, Mode=TwoWay}"/>

                                <TextBlock Grid.Row="1" Text="Colour" VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6">
                                    <Button Tag="#00FF66" Background="#00FF66" Width="24" Height="24" Padding="0" Margin="0,0,6,0" Click="CrosshairColor_Click"/>
                                    <Button Tag="#00FFFF" Background="#00FFFF" Width="24" Height="24" Padding="0" Margin="0,0,6,0" Click="CrosshairColor_Click"/>
                                    <Button Tag="#FF2D2D" Background="#FF2D2D" Width="24" Height="24" Padding="0" Margin="0,0,6,0" Click="CrosshairColor_Click"/>
                                    <Button Tag="#FFE600" Background="#FFE600" Width="24" Height="24" Padding="0" Margin="0,0,6,0" Click="CrosshairColor_Click"/>
                                    <Button Tag="#FF00FF" Background="#FF00FF" Width="24" Height="24" Padding="0" Margin="0,0,6,0" Click="CrosshairColor_Click"/>
                                    <Button Tag="#FFFFFF" Background="#FFFFFF" Width="24" Height="24" Padding="0" Margin="0,0,10,0" Click="CrosshairColor_Click"/>
                                    <TextBox Width="90" Text="{Binding Color, UpdateSourceTrigger=LostFocus}"/>
                                </StackPanel>

                                <TextBlock Grid.Row="2" Text="Length" VerticalAlignment="Center"/>
                                <Slider Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="40" Value="{Binding Size, Mode=TwoWay}" Margin="0,6" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Size}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="3" Text="Thickness" VerticalAlignment="Center"/>
                                <Slider Grid.Row="3" Grid.Column="1" Minimum="1" Maximum="10" Value="{Binding Thickness, Mode=TwoWay}" Margin="0,6" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Thickness}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="4" Text="Gap" VerticalAlignment="Center"/>
                                <Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="30" Value="{Binding Gap, Mode=TwoWay}" Margin="0,6" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding Gap}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="5" Text="Opacity" VerticalAlignment="Center"/>
                                <Slider Grid.Row="5" Grid.Column="1" Minimum="0.2" Maximum="1" Value="{Binding Opacity, Mode=TwoWay}" Margin="0,6" SmallChange="0.05" LargeChange="0.1"/>
                                <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding Opacity, StringFormat={}{0:P0}}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="6" Text="Move left/right" VerticalAlignment="Center"/>
                                <Slider Grid.Row="6" Grid.Column="1" Minimum="-60" Maximum="60" Value="{Binding OffsetX, Mode=TwoWay}" Margin="0,6" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding OffsetX}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="7" Text="Move up/down" VerticalAlignment="Center"/>
                                <Slider Grid.Row="7" Grid.Column="1" Minimum="-60" Maximum="60" Value="{Binding OffsetY, Mode=TwoWay}" Margin="0,6" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                <TextBlock Grid.Row="7" Grid.Column="2" Text="{Binding OffsetY}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                <StackPanel Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6">
                                    <CheckBox Content="Black outline" IsChecked="{Binding Outline, Mode=TwoWay}" Margin="0,0,16,0"/>
                                    <CheckBox Content="Centre dot" IsChecked="{Binding CenterDot, Mode=TwoWay}"/>
                                </StackPanel>
                                <Button Grid.Row="9" Grid.Column="1" Content="Re-centre" HorizontalAlignment="Left" Margin="0,6,0,0" Click="CrosshairRecenter_Click"/>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Preview" Margin="14,10" Foreground="{StaticResource SubTextBrush}"/>
                                <Border Height="200" CornerRadius="0,0,10,10" ClipToBounds="True">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#7FB2E5" Offset="0"/>
                                            <GradientStop Color="#C9B48A" Offset="0.55"/>
                                            <GradientStop Color="#5E7D3A" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Canvas x:Name="CrosshairPreview" Width="238" Height="200"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- FPS benchmark -->
            <ScrollViewer x:Name="BenchmarkPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="24,16,24,20">
                    <TextBlock Text="FPS Benchmark" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Measure your real in-game FPS before and after tweaks. Start a run, then play normally (same mode and map each time for a fair comparison). Uses Intel PresentMon, a free open-source frame recorder. Needs administrator rights."/>
                    <Border x:Name="PresentMonCard" Style="{StaticResource Card}" BorderBrush="{StaticResource WarnBrush}" Visibility="Collapsed">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Download (1 MB)" Style="{StaticResource PrimaryButton}" Margin="0" Click="DownloadPresentMon_Click"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,12,0" VerticalAlignment="Center"
                                       Text="PresentMon isn't installed yet. SpudBoost downloads it once from Intel's official GitHub page (signed by Intel)."/>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <WrapPanel>
                                <StackPanel Margin="0,0,16,8">
                                    <TextBlock Text="Game" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="BenchGameCombo" Width="240"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,8">
                                    <TextBlock Text="Length" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="BenchLengthCombo" Width="120"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,8">
                                    <TextBlock Text="Label" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="BenchLabelBox" Width="220" Text="Before tweaks"/>
                                </StackPanel>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="BenchStartButton" Content="Start measuring" Style="{StaticResource PrimaryButton}" Click="StartBenchmark_Click"/>
                                <TextBlock x:Name="BenchStatus" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <DockPanel Margin="0,16,0,10">
                        <Button DockPanel.Dock="Right" Content="Clear history" Margin="0" Click="ClearBenchmarks_Click"/>
                        <TextBlock Text="Results" Style="{StaticResource SectionTitle}" Margin="0"/>
                    </DockPanel>
                    <TextBlock Foreground="{StaticResource SubTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Average FPS is overall smoothness. 1% and 0.1% lows are your worst moments (stutters), which often matter more."/>
                    <ItemsControl x:Name="BenchList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="18,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold">
                                                <Run Text="{Binding Label, Mode=OneWay}"/><Run Text="  ·  " Foreground="{StaticResource SubTextBrush}"/><Run Text="{Binding Game, Mode=OneWay}" Foreground="{StaticResource SubTextBrush}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding When}" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                                            <TextBlock Text="{Binding Comparison}" Foreground="{StaticResource WarnBrush}" FontSize="12"
                                                       Visibility="{Binding Comparison, Converter={x:Static local:NotNullToVisibility.Instance}}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Summary}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- One game's settings (Roblox, Minecraft, CS2): same page, filled from the selected game -->
            <ScrollViewer x:Name="GamePage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="24,16,24,20">
                    <TextBlock x:Name="GameTitle" Style="{StaticResource PageTitle}"/>
                    <TextBlock x:Name="GameDescription" Style="{StaticResource PageSubtitle}"/>
                    <Border x:Name="GameWarning" Style="{StaticResource Card}" BorderBrush="{StaticResource WarnBrush}" Visibility="Collapsed">
                        <TextBlock x:Name="GameWarningText" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap"/>
                    </Border>

                    <StackPanel x:Name="GameEditor">
                        <TextBlock Text="Presets" Style="{StaticResource SectionTitle}"/>
                        <ItemsControl x:Name="GamePresetList" Margin="0,0,0,4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" Margin="0,0,8,6" Click="GamePreset_Click"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Settings" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}">
                            <ItemsControl x:Name="GameSettingList" ItemTemplateSelector="{StaticResource GameSettingSelector}"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="Save to game" Style="{StaticResource PrimaryButton}" Click="SaveGame_Click"/>
                            <Button Content="Reload from file" Click="ReloadGame_Click"/>
                            <Button Content="Restore original settings" Click="RestoreGame_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Windows tweaks for this game" Style="{StaticResource SectionTitle}" Margin="0,18,0,6"/>
                    <ItemsControl x:Name="GameTweakList" ItemTemplate="{StaticResource TweakCard}"/>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <ToggleButton x:Name="GameBoostSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="GameBoostSwitch_Click"/>
                            <StackPanel>
                                <TextBlock Text="Game Boost while playing" FontWeight="SemiBold"/>
                                <TextBlock Text="Raises this game's priority and lowers background apps while it runs (Game Boost must be on). Also lets the NVIDIA performance tweak cover this game."
                                           Foreground="{StaticResource SubTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,12,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- My profiles: save and switch between your own setups -->
            <ScrollViewer x:Name="ProfilesPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="24,16,24,20">
                    <TextBlock Text="My profiles" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Save your current setup under a name, switch back to it any time, and publish it so anyone can install it. Loading a profile shows what will change first, then turns tweaks on and off to match (using SpudBoost's normal undo) and puts back the saved game settings and crosshairs."/>
                    <TextBlock Text="Save current setup" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Name" VerticalAlignment="Center" Width="60"/>
                                <TextBox x:Name="NewProfileName" Width="240" VerticalContentAlignment="Center"/>
                                <Button Content="Save profile" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="SaveProfile_Click"/>
                            </StackPanel>
                            <WrapPanel>
                                <CheckBox x:Name="ProfileTweaksBox" Content="Tweaks" IsChecked="True" Margin="0,0,16,0"/>
                                <CheckBox x:Name="ProfileFortniteBox" Content="Fortnite settings" IsChecked="True" Margin="0,0,16,0"/>
                                <CheckBox x:Name="ProfileCrosshairBox" Content="Crosshairs" IsChecked="True" Margin="0,0,16,0"/>
                                <CheckBox x:Name="ProfileGamesBox" Content="Roblox, Minecraft and CS2 settings" IsChecked="True"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <DockPanel Margin="0,14,0,6">
                        <Button DockPanel.Dock="Right" Content="Install a config…" Margin="0" Click="InstallConfig_Click"
                                ToolTip="Add a .spudboost file someone shared with you"/>
                        <TextBlock Text="Saved profiles" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Foreground="{StaticResource SubTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Publish turns a profile into a .spudboost file you can send or post anywhere. Anyone with SpudBoost can double-click it (or use Install a config) to add it. Installing never changes anything until they click Load and confirm the preview."/>
                    <TextBlock x:Name="NoProfilesText" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap"
                               Text="No profiles yet. Set things up the way you like, give it a name above and click Save profile."/>
                    <ItemsControl x:Name="ProfileList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="14,8">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Load" Style="{StaticResource PrimaryButton}" Click="LoadProfile_Click"/>
                                            <Button Content="Publish" Click="PublishProfile_Click" ToolTip="Save as a .spudboost file anyone with SpudBoost can install"/>
                                            <Button Content="Update" Click="UpdateProfile_Click" ToolTip="Replace this profile with your current setup"/>
                                            <Button Content="Delete" Margin="0" Click="DeleteProfile_Click"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource SubTextBrush}" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Library: installed games with Boost & Play -->
            <ScrollViewer x:Name="LibraryPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="24,16,24,20">
                    <TextBlock Text="Library" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Your installed Steam, Epic Games and Minecraft games in one place. Boost &amp; Play switches on Game Boost, closes the apps on your close list, starts the game through its own launcher, and teaches Game Boost the game's process so it's boosted every time."/>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Refresh" Margin="0" Click="LibraryRefresh_Click"/>
                        <Grid>
                            <TextBox x:Name="LibrarySearchBox" VerticalContentAlignment="Center" Padding="28,5,8,5" Margin="0,0,8,0" TextChanged="LibrarySearch_TextChanged"/>
                            <TextBlock Text="🔍" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{StaticResource SubTextBrush}"/>
                            <TextBlock x:Name="LibrarySearchHint" Text="Search your games" Margin="29,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Foreground="#5D6577" FontSize="12"/>
                        </Grid>
                    </DockPanel>
                    <TextBlock x:Name="LibraryStatus" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="2,0,0,8" Text="Looking for games..."/>
                    <ItemsControl x:Name="LibraryList" ItemTemplate="{StaticResource GameTile}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- One game: info, launch, how optimized it is, its own tweaks -->
            <ScrollViewer x:Name="GameDetailPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <Grid Margin="24,4,24,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="330"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button Grid.ColumnSpan="3" Content="‹  Back to Library" HorizontalAlignment="Left" Margin="0,0,0,10" Padding="10,4" Click="HomeLibrary_Click"/>

                    <!-- Header: cover, name, description, tags, facts -->
                    <DockPanel Grid.Row="1" Margin="0,0,0,16">
                        <Border DockPanel.Dock="Left" Width="140" Height="187" CornerRadius="12" Background="#10131C" Margin="0,0,18,0">
                            <Grid>
                                <Grid.Clip>
                                    <RectangleGeometry Rect="0,0,140,187" RadiusX="12" RadiusY="12"/>
                                </Grid.Clip>
                                <TextBlock x:Name="DetailInitial" FontSize="54" FontWeight="Bold" Foreground="#2C3346" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="DetailCover" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>
                        <StackPanel>
                            <TextBlock x:Name="DetailName" FontSize="26" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DetailDescription" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" LineHeight="20" Margin="0,6,0,10"
                                       MaxHeight="80" TextTrimming="WordEllipsis"/>
                            <ItemsControl x:Name="DetailTags" Margin="0,0,0,10">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderHoverBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="0,0,6,4">
                                            <TextBlock Text="{Binding}" FontSize="12" Foreground="#C5CBD8"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="DetailRelease" Foreground="#B5BCCB" Margin="0,0,0,4"/>
                            <TextBlock x:Name="DetailDeveloper" Foreground="#B5BCCB"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Launch and status -->
                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Bottom" Margin="0,0,0,16" Padding="16,14">
                        <StackPanel>
                            <DockPanel>
                                <ToggleButton x:Name="DetailFavorite" DockPanel.Dock="Right" Width="40" Height="38" Margin="8,0,0,0" Cursor="Hand"
                                              ToolTip="Favourite: shows first on Home and in the Library" Click="DetailFavorite_Click">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bd" CornerRadius="10" BorderBrush="{StaticResource BorderHoverBrush}" BorderThickness="1" Background="Transparent">
                                                <TextBlock x:Name="Star" Text="&#xE734;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Star" Property="Text" Value="&#xE735;"/>
                                                    <Setter TargetName="Star" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Button x:Name="DetailLaunch" Style="{StaticResource PrimaryButton}" Margin="0" Height="38" FontSize="14" Click="DetailLaunch_Click"
                                        ToolTip="Boost &amp; Play: Game Boost on, close-list apps closed, then the game starts">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Launch Game"/>
                                    </StackPanel>
                                </Button>
                            </DockPanel>
                            <DockPanel Margin="0,16,0,8">
                                <TextBlock x:Name="DetailPercent" DockPanel.Dock="Right" FontWeight="Bold"/>
                                <TextBlock Text="Game Status" Foreground="{StaticResource SubTextBrush}"/>
                            </DockPanel>
                            <Grid x:Name="DetailBar" Height="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="2" CornerRadius="3" Background="#262D40"/>
                                <Border CornerRadius="3" Background="{DynamicResource AccentGradientBrush}"/>
                            </Grid>
                            <TextBlock x:Name="DetailPending" Foreground="{StaticResource SubTextBrush}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Media / graphics settings tabs -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" VerticalAlignment="Top">
                        <StackPanel>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,0">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="DetailMediaTab" Style="{StaticResource UnderlineTab}" GroupName="DetailTabs" IsChecked="True" Checked="DetailTab_Checked"/>
                                    <RadioButton x:Name="DetailSettingsTab" Style="{StaticResource UnderlineTab}" GroupName="DetailTabs" Content="Graphics Settings" Checked="DetailTab_Checked"/>
                                </StackPanel>
                            </Border>
                            <Grid MinHeight="260">
                                <ItemsControl x:Name="DetailMedia" Margin="14,14,4,4">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="190" Height="107" CornerRadius="8" Margin="0,0,10,10" Background="#10131C" Cursor="Hand"
                                                    MouseLeftButtonUp="DetailScreenshot_Click" ToolTip="Open full size">
                                                <Border.Clip>
                                                    <RectangleGeometry Rect="0,0,190,107" RadiusX="8" RadiusY="8"/>
                                                </Border.Clip>
                                                <Image Source="{Binding}" Stretch="UniformToFill"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel x:Name="DetailEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                                    <Border Width="40" Height="40" CornerRadius="20" Background="#1F2535" HorizontalAlignment="Center">
                                        <TextBlock x:Name="DetailEmptyIcon" Text="&#xE916;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}"/>
                                    </Border>
                                    <TextBlock x:Name="DetailEmptyTitle" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                                    <TextBlock x:Name="DetailEmptyText" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
                                    <Button x:Name="DetailEmptyButton" HorizontalAlignment="Center" Margin="0,14,0,0" Click="DetailEmptyButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Right column: game-specific tweaks and Boost-Up -->
                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <Border Style="{StaticResource Card}" Padding="16,14">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" CornerRadius="6" Background="#1F2535" Padding="8,2" VerticalAlignment="Top">
                                        <TextBlock x:Name="DetailActive" FontSize="12" FontWeight="SemiBold" Foreground="#B5BCCB"/>
                                    </Border>
                                    <TextBlock Text="&#xE9D2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Left"/>
                                </DockPanel>
                                <TextBlock Text="Game-Specific Tweaks" FontWeight="Bold" FontSize="15" Margin="0,10,0,4"/>
                                <TextBlock x:Name="DetailTweaksText" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"
                                           Text="Windows settings just for this game. Each one can be switched back off."/>
                                <ItemsControl x:Name="DetailTweaks">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,0,0,10" ToolTip="{Binding Description}">
                                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="10,0,0,0"
                                                              IsChecked="{Binding IsOn, Mode=TwoWay}" IsEnabled="{Binding CanToggle}" Click="TweakToggle_Click"/>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                                        <Border Style="{StaticResource Badge}" Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="Admin" FontSize="10" Foreground="{DynamicResource AccentBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" MaxHeight="30" TextTrimming="WordEllipsis"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button x:Name="DetailTweaksAll" Content="Turn all on" HorizontalAlignment="Stretch" Margin="0,4,0,0" Click="DetailTweaksAll_Click"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="16,14">
                            <StackPanel>
                                <DockPanel>
                                    <Border x:Name="DetailAttention" DockPanel.Dock="Right" CornerRadius="6" Background="#3A1A1E" Padding="8,2" VerticalAlignment="Top">
                                        <TextBlock Text="ⓘ Needs Attention" FontSize="12" FontWeight="SemiBold" Foreground="#FF5A6A"/>
                                    </Border>
                                    <TextBlock Text="&#xEC4A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Left"/>
                                </DockPanel>
                                <TextBlock Text="Run a Boost-Up now" FontWeight="Bold" FontSize="15" Margin="0,10,0,4"/>
                                <TextBlock x:Name="DetailBoostText" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"
                                           Text="Clear junk files and caches before you play, and make sure Game Boost is on."/>
                                <Button Content="Clean up now  ›" HorizontalAlignment="Stretch" Click="DetailBoostUp_Click"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="DetailSpudPageCard" Style="{StaticResource Card}" Padding="16,14">
                            <StackPanel>
                                <TextBlock x:Name="DetailSpudPageTitle" FontWeight="Bold" FontSize="15" Margin="0,0,0,4"/>
                                <TextBlock x:Name="DetailSpudPageText" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"/>
                                <Button x:Name="DetailSpudPageButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0" Click="DetailSpudPage_Click"/>
                                <Button x:Name="DetailCrosshairButton" Content="🎯  Crosshair settings  ›" HorizontalAlignment="Stretch" Margin="0,6,0,0"
                                        Visibility="Collapsed" Click="OpenCrosshair_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Cleaner -->
            <ScrollViewer x:Name="CleanerPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="24,16,24,20">
                    <TextBlock Text="Cleaner" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Frees up space taken by temporary files, logs and caches. Files that are in use are skipped, and temp files from the last 24 hours are left alone. Deleted files don't go to the Recycle Bin."/>
                    <!-- RAM: free standby memory -->
                    <Border Style="{StaticResource Card}" Background="{DynamicResource HeroBrush}" Margin="0,0,0,14" Padding="18,16">
                        <StackPanel>
                            <DockPanel>
                                <Button x:Name="FreeRamButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" VerticalAlignment="Center" Click="FreeRam_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Free RAM now"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="&#xE950;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="28" Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Free up RAM" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock x:Name="RamStatus" Foreground="{StaticResource SubTextBrush}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12"/>
                            <DockPanel>
                                <ToggleButton x:Name="AutoRamBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="AutoRam_Click"/>
                                <StackPanel>
                                    <TextBlock Text="Free RAM automatically while gaming" FontWeight="SemiBold"/>
                                    <TextBlock Text="When a boosted game is running and free memory drops under 1 GB, SpudBoost releases Windows' standby cache. Fixes stutter when games load new areas on 8–16 GB PCs."
                                               FontSize="12" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="0,2,12,0"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Junk files" Style="{StaticResource SectionTitle}" FontSize="15" Margin="0,4,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button x:Name="CleanButton" Content="Clean selected" Style="{StaticResource PrimaryButton}" Click="Clean_Click"/>
                        <Button Content="Scan again" Click="ScanCleaner_Click"/>
                        <TextBlock x:Name="CleanerTotal" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource SubTextBrush}"/>
                    </StackPanel>
                    <CheckBox x:Name="AutoCleanBox" Margin="0,0,0,10" Click="AutoCleanBox_Click"
                              Content="Clean automatically once a week (temp files, logs and crash dumps only; never replays or shader caches)"/>
                    <ItemsControl x:Name="CleanerList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="18,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource SubTextBrush}" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                                   VerticalAlignment="Center" Margin="16,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Debloater -->
            <ScrollViewer x:Name="DebloatPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="24,16,24,20">
                    <TextBlock Text="Debloater" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Remove preinstalled Windows apps you don't use. Only apps from a checked list of safe-to-remove extras are shown. The Microsoft Store, Xbox sign-in, security, drivers and other things Windows needs are never offered. Nothing is selected until you tick it, and anything removed can be reinstalled free from the Microsoft Store."/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button x:Name="DebloatButton" Content="Remove selected" Style="{StaticResource PrimaryButton}" Click="Debloat_Click"/>
                        <Button Content="Refresh list" Click="RefreshDebloat_Click"/>
                        <TextBlock x:Name="DebloatStatus" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource SubTextBrush}"/>
                    </StackPanel>
                    <ItemsControl x:Name="DebloatList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="18,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Note, StringFormat=⚠ {0}}" Foreground="{StaticResource WarnBrush}" FontSize="12" TextWrapping="Wrap"
                                                       Visibility="{Binding Note, Converter={x:Static local:NotNullToVisibility.Instance}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Live monitor -->
            <ScrollViewer x:Name="MonitorPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="24,16,24,20">
                    <TextBlock Text="Monitor" Style="{StaticResource PageTitle}"/>
                    <TextBlock x:Name="MonitorSubtitle" Style="{StaticResource PageSubtitle}"
                               Text="Live readings, updated every 2 seconds while this page is open. Leave it open on a second screen while you play to see what's holding your FPS back."/>
                    <UniformGrid Columns="3">
                        <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="CPU usage" Foreground="{StaticResource SubTextBrush}"/>
                                <TextBlock Text="{Binding Cpu}" Style="{StaticResource StatValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="RAM usage" Foreground="{StaticResource SubTextBrush}"/>
                                <TextBlock Text="{Binding Ram}" Style="{StaticResource StatValue}"/>
                                <TextBlock Text="{Binding RamDetail}" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="GPU usage" Foreground="{StaticResource SubTextBrush}"/>
                                <TextBlock Text="{Binding Gpu}" Style="{StaticResource StatValue}"/>
                                <TextBlock Text="{Binding GpuName}" Foreground="{StaticResource SubTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="GPU temperature" Foreground="{StaticResource SubTextBrush}"/>
                                <TextBlock Text="{Binding GpuTemp}" Style="{StaticResource StatValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="GPU clock" Foreground="{StaticResource SubTextBrush}"/>
                                <TextBlock Text="{Binding GpuClock}" Style="{StaticResource StatValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="VRAM / power" Foreground="{StaticResource SubTextBrush}"/>
                                <TextBlock Text="{Binding Vram}" Style="{StaticResource StatValue}" FontSize="24"/>
                                <TextBlock Text="{Binding GpuPower}" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <!-- In-game stats overlay settings -->
                    <Border x:Name="StatsOverlayCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=TwoWay}"/>
                                <StackPanel>
                                    <TextBlock Text="In-game stats overlay" FontWeight="SemiBold"/>
                                    <TextBlock Text="Shows GPU temperature and load, CPU and RAM use and live ping in a corner while Fortnite is the window in front (Windowed fullscreen)."
                                               Foreground="{StaticResource SubTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,12,0"/>
                                </StackPanel>
                            </DockPanel>
                            <WrapPanel Margin="0,10,0,0">
                                <TextBlock Text="Corner" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="OverlayCornerCombo" Width="130" SelectedItem="{Binding Corner, Mode=TwoWay}" Margin="0,0,16,0"/>
                                <TextBlock Text="Ping region" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="OverlayRegionCombo" Width="130" SelectedItem="{Binding PingRegion, Mode=TwoWay}" Margin="0,0,16,0"/>
                                <TextBlock Text="Show/hide key" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Width="60" Text="{Binding ToggleKey, UpdateSourceTrigger=LostFocus}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" LineHeight="20"
                                   Text="How to read it: if GPU usage stays near 95–100% in game, your graphics card is the limit, so lower graphics settings help. If GPU usage is well below that while one CPU core is busy, your CPU is the limit: graphics settings won't help much, but closing background apps, XMP and the CPU tweaks will. GPU temperatures above about 85 °C can mean dust or poor airflow."/>
                    </Border>

                    <!-- Play sessions, recorded automatically for games in the Game Boost list -->
                    <DockPanel Margin="0,14,0,6">
                        <Button DockPanel.Dock="Right" Content="Clear history" Margin="0" Click="ClearSessions_Click"/>
                        <TextBlock Text="Play sessions" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <UniformGrid Columns="3">
                        <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="Today" Foreground="{StaticResource SubTextBrush}"/>
                                <TextBlock x:Name="PlayToday" Text="0 min" Style="{StaticResource StatValue}" FontSize="24"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="Last 7 days" Foreground="{StaticResource SubTextBrush}"/>
                                <TextBlock x:Name="PlayWeek" Text="0 min" Style="{StaticResource StatValue}" FontSize="24"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Most played (7 days)" Foreground="{StaticResource SubTextBrush}"/>
                                <TextBlock x:Name="PlayTop" Text="–" Style="{StaticResource StatValue}" FontSize="24" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <TextBlock x:Name="SessionNow" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="2,0,0,6" Visibility="Collapsed"/>
                    <TextBlock x:Name="NoSessionsText" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="2,0,0,6"
                               Text="No sessions yet. SpudBoost records how long you play each game in your Game Boost list (and how hot your GPU gets) while it's running. If your GPU passes 85 °C you'll get a warning."/>
                    <ItemsControl x:Name="SessionList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="14,7" Margin="0,0,0,6">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Length}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="Hot" DockPanel.Dock="Right" Text="🔥 ran hot " Foreground="{StaticResource WarnBrush}" VerticalAlignment="Center"
                                                   Margin="0,0,10,0" Visibility="Collapsed"/>
                                        <StackPanel>
                                            <TextBlock>
                                                <Run Text="{Binding Game, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  ·  " Foreground="{StaticResource SubTextBrush}"/><Run Text="{Binding When, Mode=OneWay}" Foreground="{StaticResource SubTextBrush}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{StaticResource SubTextBrush}"/>
                                            <DockPanel Margin="0,4,0,0" Visibility="{Binding HasHogs, Converter={StaticResource BoolToVis}}">
                                                <Button DockPanel.Dock="Right" Content="Close these next time" Padding="10,3" FontSize="11" Margin="8,0,0,0"
                                                        Click="CloseHogs_Click" ToolTip="Adds these apps to Game Boost's close list"/>
                                                <TextBlock Text="{Binding HogsText}" FontSize="12" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding RanHot}" Value="True">
                                        <Setter TargetName="Hot" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Settings -->
            <ScrollViewer x:Name="SettingsPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="24,16,24,20">
                    <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="How SpudBoost runs on this PC."/>
                    <TextBlock Text="General" Style="{StaticResource SectionTitle}" FontSize="15" Margin="0,4,0,8"/>
                    <Border Style="{StaticResource Card}" Padding="16,4">
                        <StackPanel>
                            <DockPanel Margin="0,10">
                                <ToggleButton x:Name="TrayBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="TrayBox_Click"/>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE8A7;" Style="{StaticResource NavIcon}" Foreground="{DynamicResource AccentBrush}"/>
                                <StackPanel>
                                    <TextBlock Text="Keep running in the tray when closed" FontWeight="SemiBold"/>
                                    <TextBlock Foreground="{StaticResource SubTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,12,0"
                                               Text="Game Boost and the crosshair only work while SpudBoost runs. Right-click the potato icon next to the clock to exit."/>
                                </StackPanel>
                            </DockPanel>
                            <Border Height="1" Background="{StaticResource BorderBrush}"/>
                            <DockPanel Margin="0,10">
                                <ToggleButton x:Name="StartWithWindowsBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="StartWithWindowsBox_Click"/>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE7E8;" Style="{StaticResource NavIcon}" Foreground="{DynamicResource AccentBrush}"/>
                                <StackPanel>
                                    <TextBlock Text="Start when I sign in" FontWeight="SemiBold"/>
                                    <TextBlock Foreground="{StaticResource SubTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,12,0"
                                               Text="Starts hidden in the tray, without administrator rights."/>
                                </StackPanel>
                            </DockPanel>
                            <Border Height="1" Background="{StaticResource BorderBrush}"/>
                            <DockPanel Margin="0,10">
                                <ToggleButton x:Name="AutoRestorePointBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="AutoRestorePointBox_Click"/>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE81C;" Style="{StaticResource NavIcon}" Foreground="{DynamicResource AccentBrush}"/>
                                <StackPanel>
                                    <TextBlock Text="Restore point before the first tweak" FontWeight="SemiBold"/>
                                    <TextBlock Foreground="{StaticResource SubTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,12,0"
                                               Text="A Windows restore point you can go back to, on top of SpudBoost's own undo."/>
                                </StackPanel>
                            </DockPanel>
                            <Border Height="1" Background="{StaticResource BorderBrush}"/>
                            <DockPanel Margin="0,10">
                                <ToggleButton x:Name="HeatAlertBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="HeatAlertBox_Click"/>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE9CA;" Style="{StaticResource NavIcon}" Foreground="{DynamicResource AccentBrush}"/>
                                <StackPanel>
                                    <TextBlock Text="GPU heat warnings" FontWeight="SemiBold"/>
                                    <TextBlock Foreground="{StaticResource SubTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,12,0"
                                               Text="A notification if your graphics card goes above 85 °C while you play (NVIDIA)."/>
                                </StackPanel>
                            </DockPanel>
                            <Border Height="1" Background="{StaticResource BorderBrush}"/>
                            <DockPanel Margin="0,10">
                                <ToggleButton x:Name="CheckInBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="CheckInBox_Click"/>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE9D9;" Style="{StaticResource NavIcon}" Foreground="{DynamicResource AccentBrush}"/>
                                <StackPanel>
                                    <TextBlock Text="Anonymous daily check-in" FontWeight="SemiBold"/>
                                    <TextBlock Foreground="{StaticResource SubTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,12,0"
                                               Text="Once a day, sends a random ID and your SpudBoost version so we can count how many people use SpudBoost. No name, email, PC details or game info."/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Look" Style="{StaticResource SectionTitle}" FontSize="15" Margin="0,10,0,8"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Accent colour" FontWeight="SemiBold"/>
                            <TextBlock Text="Make SpudBoost yours. Changes the colour of switches, buttons and highlights."
                                       Foreground="{StaticResource SubTextBrush}" FontSize="12" Margin="0,2,0,8"/>
                            <ItemsControl x:Name="AccentList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Round swatch; the chosen one gets a white ring -->
                                        <Button Tag="{Binding Hex}" ToolTip="{Binding Name}" Width="36" Height="36" Margin="0,0,10,0" Click="Accent_Click" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid>
                                                        <Ellipse Stroke="{Binding Border}" StrokeThickness="2"/>
                                                        <Ellipse x:Name="Dot" Margin="4" Fill="{Binding Brush}" RenderTransformOrigin="0.5,0.5">
                                                            <Ellipse.RenderTransform>
                                                                <ScaleTransform x:Name="DotScale"/>
                                                            </Ellipse.RenderTransform>
                                                        </Ellipse>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Dot" Property="Margin" Value="2"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="About" Style="{StaticResource SectionTitle}" FontSize="15" Margin="0,10,0,8"/>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="DownloadUpdateButton" Content="Download update" Style="{StaticResource PrimaryButton}"
                                        Visibility="Collapsed" Click="DownloadUpdate_Click"/>
                                <Button Content="Terms of Service" Click="ViewTerms_Click"/>
                                <Button Content="Check for updates" Margin="0" Click="CheckUpdates_Click"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="VersionText" FontWeight="SemiBold"/>
                                <TextBlock x:Name="UpdateText" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="0,4,12,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Column="1" Grid.Row="2" Background="{StaticResource SidebarBrush}" Padding="24,6">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource SubTextBrush}" Text="Ready." TextTrimming="CharacterEllipsis"/>
        </Border>

        <!-- After an update: what's new and fixed in this version -->
        <Grid x:Name="WhatsNewOverlay" Grid.ColumnSpan="2" Grid.RowSpan="3" Visibility="Collapsed" Background="#D90B0D11">
            <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderHoverBrush}" BorderThickness="1" CornerRadius="14"
                    Padding="26,22" MaxWidth="640" MaxHeight="560" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <Image Source="logo.png" Width="36" Height="36" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="WhatsNewTitle" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="You're up to date. Here's what changed." Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Got it" Style="{StaticResource PrimaryButton}" Click="CloseWhatsNew_Click"/>
                        <Button x:Name="WhatsNewMoreButton" Content="See full notes on GitHub" Click="WhatsNewMore_Click"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="WhatsNewList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="Line" Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" Margin="0,2"
                                               Foreground="{StaticResource SubTextBrush}"/>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsHeading}" Value="True">
                                            <Setter TargetName="Line" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            <Setter TargetName="Line" Property="FontWeight" Value="SemiBold"/>
                                            <Setter TargetName="Line" Property="FontSize" Value="14"/>
                                            <Setter TargetName="Line" Property="Margin" Value="0,10,0,2"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBullet}" Value="True">
                                            <Setter TargetName="Line" Property="Text" Value="{Binding Text, StringFormat=•  {0}}"/>
                                            <Setter TargetName="Line" Property="Foreground" Value="{StaticResource TextBrush}"/>
                                            <Setter TargetName="Line" Property="Margin" Value="8,3,0,3"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- First-run welcome: pick a preset or skip -->
        <Grid x:Name="WelcomeOverlay" Grid.ColumnSpan="2" Grid.RowSpan="3" Visibility="Collapsed" Background="#D90B0D11">
            <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderHoverBrush}" BorderThickness="1" CornerRadius="14"
                    Padding="28,24" MaxWidth="760" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Image Source="logo.png" Width="40" Height="40" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="22" FontWeight="Bold">
                                <Run Text="Welcome to " Foreground="{StaticResource TextBrush}"/><Run Text="Spud" Foreground="{StaticResource TextBrush}"/><Run Text="Boost" Foreground="{DynamicResource AccentBrush}"/>
                            </TextBlock>
                            <TextBlock Text="Pick a starting point. You can change or undo everything later." Foreground="{StaticResource SubTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <ItemsControl x:Name="WelcomePresetList" ItemTemplate="{StaticResource PresetCard}" Margin="0,14,-8,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock x:Name="WelcomeAdminNote" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource WarnBrush}" Margin="0,4,0,0"
                               Text="Tip: some tweaks need administrator rights. Run as admin first to apply the full preset; this screen will show again."/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Skip, I'll choose tweaks myself" Click="SkipWelcome_Click"/>
                        <Button Content="Run as admin" Style="{StaticResource PrimaryButton}" Click="RestartAdmin_Click"
                                Visibility="{Binding Visibility, ElementName=WelcomeAdminNote}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Terms of Service: shown before anything else until the current version is accepted -->
        <Grid x:Name="TermsOverlay" Grid.ColumnSpan="2" Grid.RowSpan="3" Visibility="Collapsed" Background="#F20A0C12">
            <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderHoverBrush}" BorderThickness="1" CornerRadius="16"
                    Padding="28,24" MaxWidth="700" Margin="40,30" VerticalAlignment="Stretch" HorizontalAlignment="Center">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                        <Image Source="logo.png" Width="40" Height="40" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TermsTitle" Text="Terms of Service" FontSize="22" FontWeight="Bold"/>
                            <TextBlock x:Name="TermsSubtitle" Text="Please read and accept these terms to use SpudBoost." Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="TermsButtons" DockPanel.Dock="Bottom" Margin="0,14,0,0">
                        <CheckBox x:Name="TermsAgreeBox" Content="I have read and agree to the Terms of Service" Click="TermsAgree_Click"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="TermsAcceptButton" Content="Accept and continue" Style="{StaticResource PrimaryButton}" Height="38" Padding="18,6"
                                    IsEnabled="False" Click="TermsAccept_Click"/>
                            <Button Content="Decline and exit" Height="38" Click="TermsDecline_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="TermsCloseButton" DockPanel.Dock="Bottom" Content="Close" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                            Margin="0,14,0,0" Visibility="Collapsed" Click="TermsClose_Click"/>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                        <ScrollViewer x:Name="TermsScroll" VerticalScrollBarVisibility="Auto" Padding="18,12">
                            <ItemsControl x:Name="TermsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="Line" Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" LineHeight="20" Margin="0,3"
                                                   Foreground="{StaticResource SubTextBrush}"/>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsHeading}" Value="True">
                                                <Setter TargetName="Line" Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                <Setter TargetName="Line" Property="FontWeight" Value="SemiBold"/>
                                                <Setter TargetName="Line" Property="FontSize" Value="15"/>
                                                <Setter TargetName="Line" Property="Margin" Value="0,14,0,2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsBullet}" Value="True">
                                                <Setter TargetName="Line" Property="Text" Value="{Binding Text, StringFormat=•  {0}}"/>
                                                <Setter TargetName="Line" Property="Margin" Value="10,2,0,2"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
